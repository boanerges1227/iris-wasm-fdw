-- IRIS Wasm FDW: replace the IRIS host and credentials before executing.
-- Package version must match the release tag (remove its leading v).
CREATE EXTENSION IF NOT EXISTS wrappers;
CREATE FOREIGN DATA WRAPPER wasm_wrapper
  HANDLER wasm_fdw_handler VALIDATOR wasm_fdw_validator;
CREATE SERVER iris_server FOREIGN DATA WRAPPER wasm_wrapper OPTIONS (
  fdw_package_url 'https://github.com/${GITHUB_REPOSITORY}/releases/download/${RELEASE_TAG}/iris_fdw.wasm',
  fdw_package_name 'intersystems:iris-fdw',
  fdw_package_version '${PACKAGE_VERSION}',
  fdw_package_checksum '${CHECKSUM}',
  api_url 'http://YOUR_IRIS_HOST:52773/api/atelier/v3',
  namespace 'USER', username 'YOUR_READ_ONLY_USER', password 'YOUR_PASSWORD'
);
CREATE FOREIGN TABLE iris_people (name text)
  SERVER iris_server OPTIONS (query 'SELECT Name AS name FROM Sample.Person');
-- Replace Sample.Person with your actual IRIS source table.
SELECT * FROM iris_people;
